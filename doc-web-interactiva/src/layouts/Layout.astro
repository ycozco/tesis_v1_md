---
import '../styles/global.css'

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Panel de control y documentación técnica de la Tesis de Detección de Anomalías Agroexportadoras." } = Astro.props;
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Agro-Intelligence Docs</title>
    <meta name="description" content={description} />
    
    <!-- Google Fonts & Material Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

    <style>
      body {
        font-family: 'Inter', sans-serif;
        background-color: #0f1115;
      }
      .font-headline {
        font-family: 'Outfit', sans-serif;
      }
      .font-mono-data {
        font-family: 'JetBrains Mono', monospace;
      }
    </style>
  </head>
  <body class="text-slate-200 min-h-screen flex flex-col bg-[#0b0c10]">
    {/* Global Header / Navigation */}
    <header class="sticky top-0 z-50 bg-[#0f111a]/85 backdrop-blur-md border-b border-slate-800/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 hover:opacity-90 transition-opacity">
          <div class="w-9 h-9 rounded-lg bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center">
            <span class="material-symbols-outlined text-emerald-400">gavel</span>
          </div>
          <div>
            <span class="font-headline font-bold text-lg text-white leading-tight block">AgroOversight</span>
            <span class="text-[10px] text-emerald-400 font-mono-data tracking-widest uppercase">Tesis UNSA 2026</span>
          </div>
        </a>

        <nav class="hidden md:flex items-center gap-6">
          <a href="/" class="text-sm font-medium hover:text-emerald-400 transition-colors flex items-center gap-1.5">
            <span class="material-symbols-outlined text-[18px]">home</span> Inicio
          </a>
          <a href="/metodologia" class="text-sm font-medium hover:text-emerald-400 transition-colors flex items-center gap-1.5">
            <span class="material-symbols-outlined text-[18px]">grid_on</span> Metodología
          </a>
          <a href="/casos-uso" class="text-sm font-medium hover:text-emerald-400 transition-colors flex items-center gap-1.5">
            <span class="material-symbols-outlined text-[18px]">account_tree</span> Casos de Uso
          </a>
          <a href="/justificacion" class="text-sm font-medium hover:text-emerald-400 transition-colors flex items-center gap-1.5">
            <span class="material-symbols-outlined text-[18px]">menu_book</span> Justificación
          </a>
          <a href="/arquitectura" class="text-sm font-medium hover:text-emerald-400 transition-colors flex items-center gap-1.5">
            <span class="material-symbols-outlined text-[18px]">account_circle</span> Arquitectura
          </a>
        </nav>

        <div class="flex items-center gap-3">
          <a
            href="http://localhost:5173"
            target="_blank"
            class="bg-emerald-500 hover:bg-emerald-600 text-[#0b0c10] font-headline font-semibold text-xs tracking-wider uppercase py-2 px-4 rounded-lg flex items-center gap-1.5 transition-colors shadow-[0_0_15px_rgba(16,185,129,0.2)]"
          >
            <span class="material-symbols-outlined text-[16px] font-bold">rocket_launch</span>
            Abrir Sistema Web
          </a>
        </div>
      </div>
    </header>

    {/* Main Content Area */}
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <slot />
    </main>

    {/* Footer */}
    <footer class="bg-[#07080c] border-t border-slate-900 py-6 text-center text-xs text-slate-500">
      <p>© 2026 Agro-Intelligence Oversight. Tesis de Investigación Académica - Universidad Nacional de San Agustín.</p>
    </footer>
  </body>
</html>
