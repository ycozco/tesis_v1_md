FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY sistema-web-agro/backend/requirements-local.lock /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
COPY sistema-web-agro/backend /app/sistema-web-agro/backend
COPY datasets /app/datasets
COPY pipeline /app/pipeline
COPY tools/start_local_container.py /app/tools/start_local_container.py
RUN useradd --uid 10001 --create-home agro && mkdir /app/data && chown agro:agro /app/data
USER agro
EXPOSE 8000
CMD ["python", "/app/tools/start_local_container.py"]
