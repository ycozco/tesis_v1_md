# Local server configuration; real .env is intentionally not versioned.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/agro_audit
# Set a private persistent random value for deployments; otherwise FastAPI uses
# an ephemeral key and sessions expire when that process restarts.
SECRET_KEY=
RESEARCH_ALLOW_LOCAL_AI=false
RESEARCH_OLLAMA_MODEL=
RESEARCH_ALLOW_PAID_AI=false
RESEARCH_DEEPSEEK_MODEL=deepseek-flash
RESEARCH_DEEPSEEK_API_KEY=
